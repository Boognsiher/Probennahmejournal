# Kopieren nach ".env" und Werte anpassen.

# Port, auf dem der Server lauscht.
PORT=3000

# Geheimer Schlüssel zum Signieren der Login-Tokens (JWT).
# WICHTIG: Vor dem produktiven Start durch eine lange, zufällige Zeichenfolge ersetzen,
# z.B. mit: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=bitte-aendern-langer-zufallswert

# Der allererste Benutzer (Admin) wird beim ersten Start automatisch angelegt,
# sofern noch keine Benutzer in der Datenbank existieren. Danach kann der Admin
# über die App (Einstellungen -> Benutzer) weitere Konten anlegen.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=bitte-aendern
ADMIN_NAME=Administrator

# Optional: maximale Upload-Grösse pro Foto in MB.
MAX_UPLOAD_MB=15
