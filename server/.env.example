# Kopieren nach ".env" und Werte anpassen.

# Port, auf dem der Server lauscht.
PORT=3000

# Geheimer Schlüssel zum Signieren der Login-Tokens (JWT).
# WICHTIG: Vor dem produktiven Start durch eine lange, zufällige Zeichenfolge ersetzen,
# z.B. mit: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=bitte-aendern-langer-zufallswert

# Der allererste Benutzer (Admin) wird beim ersten Start automatisch angelegt,
# sofern noch keine Benutzer in der Datenbank existieren. Danach kann der Admin
# über die App (Einstellungen -> Benutzer) weitere Konten anlegen.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=bitte-aendern
ADMIN_NAME=Administrator

# Optional: maximale Upload-Grösse pro Foto in MB.
MAX_UPLOAD_MB=15

# Optional: eigene Domain(s), von denen aus die API per Browser cross-origin
# angesprochen werden darf (CORS). Kommagetrennt bei mehreren, z.B.
# CORS_ORIGIN=https://probennahmejournal.example.com
# Leer lassen = offen (jede Herkunft erlaubt) — für lokale Entwicklung/Tests
# okay, für den produktiven Einsatz die eigene Domain eintragen.
CORS_ORIGIN=

# Nur setzen (auf 1), wenn der Server TATSÄCHLICH hinter einem eigenen,
# vertrauenswürdigen Reverse Proxy läuft (Caddy/nginx, siehe README >
# Deployment) — sonst sieht der Login-Rate-Limiter die echte Client-IP nicht,
# sondern nur die des Proxys. Bei direktem Zugriff ohne Proxy NICHT setzen
# (sonst liesse sich die Client-IP über einen gefälschten Header vortäuschen
# und der Rate-Limiter umgehen).
TRUST_PROXY=
